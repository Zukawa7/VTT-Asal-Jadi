{
  "name": "vtt-asal-jadi",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build:css": "BROWSERSLIST=\"defaults\" tailwindcss -i ./src/styles/tailwind-input.css -o ./public/styles/tailwind.css --minify",
    "watch:css": "BROWSERSLIST=\"defaults\" tailwindcss -i ./src/styles/tailwind-input.css -o ./public/styles/tailwind.css --watch",
    "start": "npm run build:css && tsx src/server.ts",
    "test": "vitest run src",
    "build": "npm run build:css && tsc",
    "dev": "npm run build:css && tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "postinstall": "npm rebuild sqlite3 --build-from-source"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zukawa7/VTT-Asal-Jadi.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zukawa7/VTT-Asal-Jadi/issues"
  },
  "homepage": "https://github.com/Zukawa7/VTT-Asal-Jadi#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
